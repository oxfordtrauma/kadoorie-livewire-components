{
  "name": "@kadoorie/livewire-components",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "postcss resources/css/kadoorie.css -o resources/dist/kadoorie.css",
    "build:workbench": "esbuild resources/js/workbench.js --bundle --format=esm --outfile=resources/dist/workbench.js",
    "build:showcase": "esbuild resources/js/showcase.js --bundle --minify --format=iife --outfile=resources/dist/showcase.js",
    "dev": "postcss resources/css/kadoorie.css -o resources/dist/kadoorie.css --watch",
    "lint": "eslint resources/js resources/react resources/react-workbench tests/React tests/ReactPlaywright tests/ReactWCAG --no-error-on-unmatched-pattern",
    "format:check": "prettier --check --no-error-on-unmatched-pattern resources/js resources/css resources/react resources/react-workbench tests/React tests/ReactPlaywright tests/ReactWCAG",
    "format:write": "prettier --write --no-error-on-unmatched-pattern resources/js resources/css resources/react resources/react-workbench tests/React tests/ReactPlaywright tests/ReactWCAG",
    "typecheck": "tsc --noEmit",
    "test:js": "jest --coverage",
    "test:react": "vitest run",
    "test:react:coverage": "vitest run --coverage",
    "build:react-workbench": "vite build --config resources/react-workbench/vite.config.ts",
    "dev:react-workbench": "vite --config resources/react-workbench/vite.config.ts",
    "test:e2e": "playwright test --project=functional-mobile --project=functional-tablet --project=functional-desktop",
    "test:wcag": "playwright test --project=wcag-mobile --project=wcag-tablet --project=wcag-desktop",
    "test:react:e2e": "playwright test --project=react-functional-mobile --project=react-functional-tablet --project=react-functional-desktop",
    "test:react:wcag": "playwright test --project=react-wcag-mobile --project=react-wcag-tablet --project=react-wcag-desktop"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@alpinejs/focus": "^3.15.12",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "alpinejs": "^3.15.12",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
